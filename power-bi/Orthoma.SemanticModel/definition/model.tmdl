model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Date","Location","Provider","Payer Class","Service Line","Visit Type","Claim Status","Visits","Claims","Provider Days","SqlServer","SqlDatabase"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table Date
ref table Location
ref table Provider
ref table 'Payer Class'
ref table 'Service Line'
ref table 'Visit Type'
ref table 'Claim Status'
ref table Visits
ref table Claims
ref table 'Provider Days'
ref table 'Time Intelligence'

ref role 'Oklahoma City'
ref role Ardmore
ref role Edmond

ref cultureInfo en-US

